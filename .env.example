# =========================================================================
# ReCity - Firebase web config
# =========================================================================
# Copy this file to .env and fill in the values from:
#   Firebase Console -> Project settings -> General -> Your apps -> SDK setup
#
# These values are NOT secrets. Vite inlines them into the public JavaScript
# bundle, so anyone visiting the site can read them. That is by design.
# The project is protected by firestore.rules, the API key's HTTP referrer
# restriction, and the Auth authorized-domains list - never by hiding these.
#
# Real secrets (service account keys, admin SDK credentials, payment keys)
# must NEVER carry the VITE_ prefix and must never live in this file.
# =========================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
